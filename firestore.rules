rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Preventivi: solo utenti autenticati possono leggerli/scriverli.
    match /preventivi/{id} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasAny([
            'numeroOfferta', 'data', 'cliente', 'righe', 'totale'
           ])
        && request.resource.size() < 1048576;
      allow delete: if request.auth != null;
    }

    // Bolle di consegna (DDT): collezione separata dai preventivi.
    match /ddt/{id} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasAny([
            'numeroBollettino', 'data', 'cliente', 'righe', 'totale'
           ])
        && request.resource.size() < 1048576;
      allow delete: if request.auth != null;
    }

    // Counter sequenziale (preventivi e DDT: counters/preventivi, counters/ddt).
    match /counters/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.data.keys().hasOnly(['counter', 'year', 'lastUpdated'])
        && request.resource.data.counter is int
        && request.resource.data.counter >= 0;
    }

    // Link registrazione clienti (gestionale → modulo pubblico).
    match /client_intake_links/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['token', 'active', 'used', 'createdAt'])
        && request.resource.data.token is string
        && request.resource.data.active is bool
        && request.resource.data.used == false;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // Tutto il resto bloccato di default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
